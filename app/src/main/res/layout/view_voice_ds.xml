<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek App 风格语音页：白底、蓝色鲸鱼、按住说话 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <ImageButton
        android:id="@+id/gpt_voice_menu"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_menu"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ds_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/voice_settings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_settings"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gear"
        android:tint="@color/ds_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/voice_mic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_whale" />

        <TextView
            android:id="@+id/voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:includeFontPadding="false"
            android:text="@string/ds_voice_title"
            android:textColor="@color/ds_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_connecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:text="@string/ds_voice_listening"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/voice_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:text="@string/ds_voice_hint"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/voice_mic"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_ds_send"
        android:contentDescription="@string/cd_mic"
        android:elevation="10dp"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ds_mic"
        app:layout_constraintBottom_toTopOf="@id/voice_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/voice_close"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_ds_pill_active"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="@string/ds_voice_close"
        android:textColor="@color/ds_brand"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/voice_error_card"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_ds_pill"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/voice_mic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/voice_retry"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ds_pill_active"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/retry"
            android:textColor="@color/ds_brand"
            android:textSize="13.5sp" />

        <ImageButton
            android:id="@+id/voice_error_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ds_close" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/voice_speaker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/voice_attach"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/voice_model"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
