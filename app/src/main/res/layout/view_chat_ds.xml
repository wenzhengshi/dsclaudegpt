<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek App 风格对话页：白底、左侧标题、右侧喇叭与新建、底部输入卡片 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <ImageButton
        android:id="@+id/chat_menu"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_menu"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ds_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chat_title"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/new_conversation"
        android:textColor="@color/ds_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/chat_speaker"
        app:layout_constraintStart_toEndOf="@id/chat_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/chat_speaker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ds_speaker_off"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_speaker"
        android:tint="@color/ds_text_tertiary"
        app:layout_constraintEnd_toStartOf="@id/chat_new"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/chat_new"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ds_new_chat"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ds_plus_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/chat_more"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/chat_attach_strip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chat_title">

        <LinearLayout
            android:id="@+id/chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <HorizontalScrollView
        android:id="@+id/chat_attach_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chat_composer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/chat_attach_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_composer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ds_composer"
        android:elevation="3dp"
        app:layout_constraintDimensionRatio="1020:265"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="13.33dp"
            android:layout_marginTop="6.67dp"
            android:background="@null"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/ds_hint_reply"
            android:imeOptions="actionSend"
            android:includeFontPadding="false"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="0dp"
            android:paddingTop="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textColor="@color/ds_text"
            android:textColorHint="@color/ds_composer_placeholder"
            android:textCursorDrawable="@drawable/ds_composer_cursor"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.705882" />

        <LinearLayout
            android:id="@+id/chat_modes"
            android:layout_width="0dp"
            android:layout_height="26.67dp"
            android:layout_marginStart="9dp"
            android:layout_marginBottom="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.509804">

            <LinearLayout
                android:id="@+id/chat_think"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6.67dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_composer_mode"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9.67dp"
                android:paddingEnd="0dp">

                <ImageView
                    android:id="@+id/chat_think_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_composer_think"
                    android:translationY="0.33dp" />

                <TextView
                    android:id="@+id/chat_think_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/ds_think"
                    android:textColor="@color/ds_composer_blue"
                    android:textSize="11.67sp"
                    android:translationY="-0.67dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_composer_mode"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="0dp">

                <ImageView
                    android:id="@+id/chat_search_icon"
                    android:layout_width="13.33dp"
                    android:layout_height="13.33dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_composer_search"
                    android:translationY="0.33dp" />

                <TextView
                    android:id="@+id/chat_search_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/ds_search"
                    android:textColor="@color/ds_composer_blue"
                    android:textSize="11.67sp"
                    android:translationY="-0.67dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_actions"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12.33dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.166667">

            <ImageButton
                android:id="@+id/chat_attach"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16.67dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_attach"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ds_composer_more" />

            <ImageButton
                android:id="@+id/chat_mic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/chat_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_composer_voice"
                android:contentDescription="@string/cd_voice"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ds_composer_voice" />
        </LinearLayout>

        <TextView
            android:id="@+id/chat_model"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
