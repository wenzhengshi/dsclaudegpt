<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek 风格助手消息：无气泡正文 + 灰色操作行 + 右侧刷新 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <!-- 思考过程：思考中实时展开，回答完成后收起，点标题栏可重新展开 -->
    <LinearLayout
        android:id="@+id/msg_ai_reasoning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_thought_card_ds"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/msg_ai_reasoning_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/msg_ai_reasoning_spinner"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ring_loading"
                android:tint="@color/ds_text_tertiary" />

            <TextView
                android:id="@+id/msg_ai_reasoning_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12.5sp" />

            <ImageView
                android:id="@+id/msg_ai_reasoning_chevron"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/ds_text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/msg_ai_reasoning_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ds_text_secondary"
            android:textIsSelectable="true"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/msg_ai_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/ds_text"
        android:textIsSelectable="true"
        android:textSize="16sp" />

    <!-- 参考图实测：图标行高 33dp、与正文间距约 19dp、单个图标视觉 14dp、
         相邻图标中心距 33dp；第一个图标与正文左缘对齐，刷新图标与正文右缘对齐。
         该图标行由 assets/ds_actions.html 在 WebView 中逐像素绘制，其余部分保持原生。 -->
    <cn.jicreate.jicreate_app.a2dde3930ff.DsActionsView
        android:id="@+id/msg_ai_actions"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:layout_marginTop="10dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/msg_ai_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:text="@string/disclaimer"
        android:textColor="@color/ds_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
