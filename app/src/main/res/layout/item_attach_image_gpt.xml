<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attach_item_root"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_marginEnd="8dp"
    android:elevation="3dp">

    <ImageView
        android:id="@+id/attach_item_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gpt_attach_thumb"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_starburst" />

    <ImageView
        android:id="@+id/attach_item_loading"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_ring_loading"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/attach_item_remove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/bg_gpt_remove"
        android:contentDescription="@string/attach_remove"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_white" />
</FrameLayout>
