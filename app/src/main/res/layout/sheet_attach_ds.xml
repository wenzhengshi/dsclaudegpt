<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek 风格附件面板：纯白大圆角、拖动条 + 分组标题，
     顶部三宫格“拍照 / 照片 / 文件”，下方是“深度思考 / 智能搜索”两个真实开关。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_attach_sheet"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ds_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:text="@string/ds_attach_title"
        android:textColor="@color/ds_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/attach_tile_camera"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_attach_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ds_attach_icon">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/ds_icon" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/ds_attach_camera"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/attach_tile_photo"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_attach_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ds_attach_icon">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_photo"
                        android:tint="@color/ds_icon" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/attach_photo"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/attach_tile_file"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_attach_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ds_attach_icon">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_file_upload"
                        android:tint="@color/ds_icon" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/attach_file"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />
            </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@color/ds_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/attach_ds_think_row"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/attach_ds_think_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_think"
                android:tint="@color/ds_icon" />

            <TextView
                android:id="@+id/attach_ds_think_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/ds_attach_think"
                android:textColor="@color/ds_text"
                android:textSize="15.5sp" />

            <FrameLayout
                android:id="@+id/attach_ds_think_track"
                android:layout_width="46dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_toggle_off">

                <View
                    android:id="@+id/attach_ds_think_thumb"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_toggle_thumb" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/attach_ds_search_row"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/attach_ds_search_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_globe"
                android:tint="@color/ds_icon" />

            <TextView
                android:id="@+id/attach_ds_search_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/ds_attach_search"
                android:textColor="@color/ds_text"
                android:textSize="15.5sp" />

            <FrameLayout
                android:id="@+id/attach_ds_search_track"
                android:layout_width="46dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_toggle_off">

                <View
                    android:id="@+id/attach_ds_search_thumb"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_toggle_thumb" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
