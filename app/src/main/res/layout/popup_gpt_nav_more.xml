<?xml version="1.0" encoding="utf-8"?>
<!-- ChatGPT 会话标题栏 · 更多操作：分享页面 / 复制链接 / 删除草稿 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gpt_nav_popover"
    android:orientation="vertical"
    android:padding="5.33dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.015"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:text="@string/gpt_nav_more_title"
        android:textColor="@color/gpt_nav_muted"
        android:textSize="11.33sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nav_share"
            android:layout_width="match_parent"
            android:layout_height="30.67dp"
            android:background="@drawable/bg_gpt_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.008"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/gpt_nav_share_page"
            android:textColor="@color/gpt_nav_ink"
            android:textSize="13.33sp" />

        <TextView
            android:id="@+id/nav_copy"
            android:layout_width="match_parent"
            android:layout_height="30.67dp"
            android:layout_marginTop="0.67dp"
            android:background="@drawable/bg_gpt_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.008"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/gpt_nav_copy_link"
            android:textColor="@color/gpt_nav_ink"
            android:textSize="13.33sp" />

        <TextView
            android:id="@+id/nav_delete"
            android:layout_width="match_parent"
            android:layout_height="30.67dp"
            android:layout_marginTop="0.67dp"
            android:background="@drawable/bg_gpt_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.008"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/gpt_nav_delete_draft"
            android:textColor="@color/gpt_nav_danger"
            android:textSize="13.33sp" />
    </LinearLayout>
</LinearLayout>
