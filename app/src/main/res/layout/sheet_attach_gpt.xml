<?xml version="1.0" encoding="utf-8"?>
<!-- ChatGPT 附件菜单：按参考图 765x1600 的卡片比例还原。
     屏幕宽 765px、面板宽 510px（66.4%），换算到 360dp 屏为 240dp；
     白色 #FFFFFF 大圆角悬浮卡片位于左下角，圆角 24dp、距左 32dp、距底 14dp，
     高 298dp（5 行 x 56dp + 上下 8/10dp 内边距）。
     行内左侧是 34dp 的 #E8E8E8 圆形图标底配黑色线性图标，文字 16sp。
     卡片保持纯净的独立悬浮形态，不再外挂探出的语音胶囊。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gpt_attach_sheet"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/attach_tile_camera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gpt_attach_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_gpt_attach_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attach_menu_camera"
                    android:tint="@color/gpt_text" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/gpt_attach_camera"
                android:textColor="@color/gpt_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_tile_photo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gpt_attach_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_gpt_attach_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attach_menu_photo"
                    android:tint="@color/gpt_text" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/gpt_attach_album"
                android:textColor="@color/gpt_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_tile_file"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gpt_attach_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_gpt_attach_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attach_menu_file"
                    android:tint="@color/gpt_text" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/gpt_attach_file"
                android:textColor="@color/gpt_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_row_plugin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gpt_attach_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_gpt_attach_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attach_menu_plugin"
                    android:tint="@color/gpt_text" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/gpt_attach_plugin"
                android:textColor="@color/gpt_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_row_think"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gpt_attach_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_gpt_attach_icon">

                <ImageView
                    android:id="@+id/attach_think_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attach_menu_think" />
            </FrameLayout>

            <TextView
                android:id="@+id/attach_think_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/gpt_attach_deep_think"
                android:textColor="@color/gpt_text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/attach_think_check"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:tint="@color/gpt_blue"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
