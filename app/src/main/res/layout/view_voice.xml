<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_voice_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/voice_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_white_circle"
            android:contentDescription="@string/cd_settings"
            android:elevation="4dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:includeFontPadding="false"
            android:text="@string/incognito"
            android:textColor="#4A4A46"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/voice_error_card"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="96dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_error_card"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/conn_error"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/conn_error_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/voice_retry"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_retry_outline"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/retry"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <ImageButton
                android:id="@+id/voice_error_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voice_connecting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/voice_mic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.60">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_starburst" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:includeFontPadding="false"
                android:text="@string/connecting"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voice_failed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/voice_mic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.59">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ghost_filled" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="@string/incognito_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/voice_mic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_white_circle"
            android:contentDescription="@string/cd_mic"
            android:elevation="7dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic_gray"
            app:layout_constraintBottom_toTopOf="@id/voice_bottom_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="46dp" />

        <LinearLayout
            android:id="@+id/voice_bottom_row"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/voice_attach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_white_circle"
                android:contentDescription="@string/cd_attach"
                android:elevation="4dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus" />

            <TextView
                android:id="@+id/voice_model"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_white"
                android:drawableEnd="@drawable/ic_chevron_updown"
                android:drawablePadding="7dp"
                android:elevation="4dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:text="@string/model_compact"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/voice_speaker"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_white_circle"
                android:contentDescription="@string/cd_voice"
                android:elevation="4dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speaker" />

            <ImageButton
                android:id="@+id/voice_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_black_circle"
                android:contentDescription="@string/cd_close"
                android:elevation="4dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close_white" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
