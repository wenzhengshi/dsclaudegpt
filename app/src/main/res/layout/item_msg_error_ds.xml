<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/bg_ds_error_card"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:id="@+id/msg_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/error_title"
        android:textColor="#E5484D"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/msg_error_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/ds_text_secondary"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/msg_error_retry"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/bg_ds_outline"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:text="@string/retry"
        android:textColor="@color/ds_text"
        android:textSize="13.5sp" />
</LinearLayout>
