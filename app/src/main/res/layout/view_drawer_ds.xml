<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek App 风格侧边栏：顶部搜索、按时间分组的会话列表、底部头像与名称 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/drawer_search_box"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_search" />

            <EditText
                android:id="@+id/drawer_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/ds_search_hint"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/ds_text"
                android:textColorHint="@color/ds_text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/drawer_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear"
            android:tint="@color/ds_text_secondary" />
    </LinearLayout>

    <!-- 隐藏占位：保持与其它皮肤相同的控件 id，避免公共逻辑空指针 -->
    <LinearLayout
        android:id="@+id/drawer_nav_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_nav_projects"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_nav_code"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_nav_artifacts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/drawer_close"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/drawer_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/drawer_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="18dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/ds_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_ds_avatar">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_cat" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/ds_profile_name"
            android:textColor="@color/ds_text"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/drawer_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_ds_pill_active"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_plus"
                android:tint="@color/ds_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:text="@string/ds_new_chat"
                android:textColor="@color/ds_brand"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/gpt_avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
