<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_drawer"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drawer_nav_chat"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"
                android:text="@string/nav_chat"
                android:textColor="@color/text_nav"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawer_nav_projects"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_projects" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"
                android:text="@string/nav_projects"
                android:textColor="@color/text_nav"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawer_nav_code"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"
                android:text="@string/nav_code"
                android:textColor="@color/text_nav"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawer_nav_artifacts"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_artifacts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:includeFontPadding="false"
                android:text="@string/nav_artifacts"
                android:textColor="@color/text_nav"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="@color/divider_drawer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/recent"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/drawer_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/drawer_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="100dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawer_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_drawer_fade" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="82dp">

        <ImageButton
            android:id="@+id/drawer_close"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_orange_circle"
            android:contentDescription="@string/cd_close"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_white" />

        <TextView
            android:id="@+id/drawer_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_black_pill"
            android:drawableStart="@drawable/ic_plus_white"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="15dp"
            android:paddingEnd="18dp"
            android:text="@string/new_chat"
            android:textColor="@color/card"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
